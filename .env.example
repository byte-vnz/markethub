APP_NAME=MarketHub
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/market-stall
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=markethub_lgu
DB_USERNAME=markethub
DB_PASSWORD=
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
MAIL_MAILER=log
DEMO_PASSWORD=

# Opt-in local/testing account provisioning; never put real credentials in this file.
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@marketstall.local
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Lease issuance stays blocked until LGU approves numbering and rental treatment.
CONTRACT_CONTROL_PREFIX=SPPM
CONTRACT_NUMBER_FORMAT="{prefix}-{period}-{sequence}"
CONTRACT_NUMBERING_APPROVAL=
CONTRACT_RENTAL_POLICY_APPROVAL=
CONTRACT_PDF_EXECUTABLE=
CONTRACT_PDF_TIMEOUT=60
