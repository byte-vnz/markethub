  "narrative": {
    "northStar": "The Market Operations Desk",
    "overview": "MarketHub keeps the visual identity of the supplied prototype: a navy navigation rail, blue actions, a light work surface and white bordered panels. The interface supports repeat visits by LGU staff working with stalls, tenants and financial records on desktop and tablet. Its character is practical, compact and readable.\n\nSystem typography, clear labels and familiar controls carry the work. The market grid is the signature visual surface; occupancy colors make it scannable while adjacent or stacked details explain the selected record. New screens inherit this established grammar rather than introducing a separate visual concept or imagery.",
    "keyCharacteristics": [
      "Navy navigation and blue action emphasis.",
      "White bordered panels on a light canvas.",
      "Compact tables with readable numbers and explicit labels.",
      "Occupancy colors paired with status text.",
      "Desktop and tablet layouts with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Separate Status Rule",
        "body": "Occupancy colors describe the stall; payment status remains separate and explicitly labeled.",
        "section": "colors"
      },
      {
        "name": "The Readable Record Rule",
        "body": "Keep table numbers aligned with tabular numerals and retain explicit field labels when space is constrained.",
        "section": "typography"
      },
      {
        "name": "The Preserve the Record Rule",
        "body": "Let wide tables and maps scroll locally instead of squeezing their contents until labels and amounts become unreadable.",
        "section": "layout"
      },
      {
        "name": "The State Before Shadow Rule",
        "body": "Use rings for interaction state and borders for panel boundaries.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the prototype's navy navigation, blue actions and light bordered workspace.",
      "Do retain Segoe UI / Arial system typography and the compact readable type hierarchy.",
      "Do pair occupancy colors with written status and keep financial status separate.",
      "Do maintain visible keyboard focus, explicit labels and local overflow for wide records."
    ],
    "donts": [
      "Don't replace the established interface with a new visual concept or decorative imagery.",
      "Don't use occupancy color as evidence of payment status.",
