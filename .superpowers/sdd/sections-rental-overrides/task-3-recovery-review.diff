+
+class RentalOverrideWorkflowTest extends TestCase
+{
+    use ApprovedRentalConfiguration, RefreshDatabase;
+
+    private $requester;
+    private $reviewer;
+    private $tenant;
+    private $stall;
+    private $section;
+    private $assignment;
+    private $url;
